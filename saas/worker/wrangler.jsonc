// The Worker that serves the published sites (developers.cloudflare.com/workers/wrangler/configuration, 2026-10-21).
// Route "*/*" on the sites zone: covers <slug>.seusites.com.br and every custom domain (Cloudflare for SaaS).
// Secrets (never here): npx wrangler secret put PLATFORM_SECRET
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webconstructor-sites",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "SITES", "bucket_name": "webconstructor-sites" }],
  "vars": {
    // the sites domain, with the dot: <slug>.seusites.com.br
    "SITES_SUFFIX": ".seusites.com.br",
    // the only host that accepts publishing and domain mapping (with the secret)
    "PLATFORM_HOST": "publish.seusites.com.br",
    // the Edge Function that stores submitted forms
    "FORMS_ENDPOINT": "https://SEU-PROJETO.supabase.co/functions/v1/form-submit",
    // the Edge Function of the apps' database (app.db, app.auth): the Worker forwards /_api/* to it
    "DATA_ENDPOINT": "https://SEU-PROJETO.supabase.co/functions/v1/site-data",
    // where the free plan badge links to
    "BADGE_URL": "https://app.seudominio.com.br/?ref=selo"
  },
  "routes": [{ "pattern": "*/*", "zone_name": "seusites.com.br" }]
}
