          }
         ]
        }
       },
       {
        "id": "a3",
        "type": "button",
        "name": "Zerar",
        "tag": "button",
        "attributes": {},
        "classes": [],
        "styles": {},
        "text": "Zerar",
        "children": [],
        "logic": {
         "on": [
          {
           "event": "click",
           "code": "state.count = 0"
          }
         ],
         "binds": {
          "attr:disabled": "state.count === 0"
         }
        }
       },
       {
        "id": "a4",
        "type": "div",
        "name": "Relogio",
        "tag": "div",
        "attributes": {},
        "classes": [],
        "styles": {},
        "text": null,
        "children": [],
        "logic": {
         "component": "Etiqueta",
         "binds": {
          "prop:label": "'Etiqueta ' + state.count"
         },
         "on": [
          {
           "event": "pronto",
           "code": "state.componentReady = $event.detail"
          }
         ]
        }
       },
       {
        "id": "a5",
        "type": "paragraph",
        "name": "Frames",
        "tag": "p",
        "attributes": {},
        "classes": [],
        "styles": {},
        "text": "",
        "children": [],
        "logic": {
         "on": [
          {
           "event": "frame",
           "code": "state.frames++"
          }
         ],
         "text": "state.frames > 10 ? 'animando' : 'parado'"
        }
       },
       {
        "id": "a6",
        "type": "paragraph",
        "name": "Erro",
        "tag": "p",
        "attributes": {},
        "classes": [],
        "styles": {},
        "text": "",
        "children": [],
        "logic": {
         "text": "state.count +"
        }
       }
      ]
     },
     {
      "id": "a17",
      "type": "section",
      "name": "Tarefas",
