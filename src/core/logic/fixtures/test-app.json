        "tag": "h2",
        "attributes": {},
        "classes": [],
        "styles": {},
        "text": "Contador",
        "children": [],
        "logic": {
         "text": "'Contador: ' + state.count + ' (dobro ' + fn.double(state.count) + ')'"
        }
       },
       {
        "id": "a2",
        "type": "button",
        "name": "Mais",
        "tag": "button",
