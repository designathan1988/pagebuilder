 "app": {
  "variables": [
   {
    "name": "tasks",
    "type": "list",
    "initial": [
     {
      "id": "t1",
      "text": "Experimentar o painel App",
      "done": true
     },
     {
      "id": "t2",
      "text": "Criar meu primeiro app",
      "done": false
     }
    ],
    "persist": true
   },
   {
    "name": "draft",
    "type": "text",
    "initial": ""
   },
   {
    "name": "filter",
    "type": "text",
    "initial": "all"
   }
  ],
  "scripts": [
   {
    "name": "tasks",
    "code": "// what the page does with its tasks: every expression calls these as fn.add(), fn.visible()...\nexport function add() {\n  const text = state.draft.trim()\n  if (text === '') return\n  state.tasks.push({ id: app.uid(), text, done: false })\n  state.draft = ''\n}\n\nexport function visible() {\n  if (state.filter === 'open') return state.tasks.filter((task) => !task.done)\n  if (state.filter === 'done') return state.tasks.filter((task) => task.done)\n  return state.tasks\n}\n\nexport function clearDone() {\n  state.tasks = state.tasks.filter((task) => !task.done)\n}\n"
   }
  ]
 }
}
