 "app": {
  "variables": [
   {
    "name": "mode",
    "type": "text",
    "initial": "login"
   },
   {
    "name": "form",
    "type": "object",
    "initial": {
     "email": "",
     "password": "",
     "name": ""
    }
   },
   {
    "name": "error",
    "type": "text",
    "initial": ""
   },
   {
    "name": "busy",
    "type": "boolean",
    "initial": false
   },
   {
    "name": "posts",
    "type": "list",
    "initial": []
   },
   {
    "name": "notes",
    "type": "list",
    "initial": []
   },
   {
    "name": "draft",
    "type": "text",
    "initial": ""
   },
   {
    "name": "note",
    "type": "text",
    "initial": ""
   }
  ],
  "tables": [
   {
    "name": "posts",
    "read": "public",
    "write": "members"
   },
   {
    "name": "notes",
    "read": "owner",
    "write": "members"
   }
  ],
  "scripts": [
   {
    "name": "club",
    "code": "// The community's code: the members sign up and in with app.auth, the wall and the notes live in the database\n// (app.db). Published on the platform, they are kept in the cloud; in the preview, in this browser.\nexport async function load() {\n  try {\n    state.posts = await app.db.list('posts', { order: '-_created', limit: 50 })\n    state.notes = app.auth.user ? await app.db.list('notes', { mine: true }) : []\n  } catch (error) {\n    state.error = error.message\n  }\n}\n\nexport async function enter() {\n  state.error = ''\n  state.busy = true\n  try {\n    const { email, password, name } = state.form\n    if (state.mode === 'signup') await app.auth.signup({ email, password, name })\n    else await app.auth.login({ email, password })\n    state.form = { email: '', password: '', name: '' }\n    await load()\n    app.toast('Welcome, ' + (app.auth.user.name || app.auth.user.email) + '!')\n  } catch (error) {\n    state.error = error.message\n  } finally {\n    state.busy = false\n  }\n}\n\nexport async function leave() {\n  app.auth.logout()\n  await load()\n}\n\nexport async function post() {\n  const text = state.draft.trim()\n  if (text === '') return\n  const user = app.auth.user\n  await app.db.add('posts', { text: text, author: user.name || user.email })\n  state.draft = ''\n  await load()\n  app.toast('Post published')\n}\n\nexport async function removePost(id) {\n  await app.db.remove('posts', id)\n  await load()\n}\n\nexport async function addNote() {\n  const text = state.note.trim()\n  if (text === '') return\n  await app.db.add('notes', { text: text })\n  state.note = ''\n  await load()\n}\n\nexport async function removeNote(id) {\n  await app.db.remove('notes', id)\n  await load()\n}\n\n// who may remove a row: the member who wrote it, or an admin of the site\nexport function mine(row) {\n  const user = app.auth.user\n  return user !== null && (user.role === 'admin' || row._owner === user.id)\n}\n\nexport function when(iso) {\n  return new Date(iso).toLocaleString('en', { dateStyle: 'short', timeStyle: 'short' })\n}\n"
   }
  ]
 }
