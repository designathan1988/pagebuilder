    "name": "html",
    "type": "text",
    "initial": "<h2>My document</h2><p>Write here. Select some text and use the toolbar above.</p>",
    "persist": true
   },
   {
    "name": "fileName",
    "type": "text",
    "initial": "document",
    "persist": true
   }
  ],
  "scripts": [
   {
    "name": "document",
    "code": "// the editor's files: counting words, saving and opening documents\nexport function words(html) {\n  const text = new DOMParser().parseFromString(html, 'text/html').body.textContent || ''\n  return text.trim() === '' ? 0 : text.trim().split(/\\s+/).length\n}\n\nexport function download(kind) {\n  const name = (state.fileName.trim() || 'document') + '.' + kind\n  if (kind === 'txt') app.download(name, new DOMParser().parseFromString(state.html, 'text/html').body.innerText, 'text/plain')\n  else app.download(name, '<!DOCTYPE html><meta charset=\"utf-8\"><title>' + state.fileName + '</title>' + state.html, 'text/html')\n}\n\nexport async function open() {\n  const file = await app.pick('.html,.htm,.txt,.md')\n  if (!file) return\n  state.fileName = file.name.replace(/\\.[^.]+$/, '')\n  const html = /\\.html?$/i.test(file.name) ? new DOMParser().parseFromString(file.text, 'text/html').body.innerHTML : file.text.split('\\n').map((line) => '<p>' + line.replace(/</g, '&lt;') + '</p>').join('')\n  state.html = html\n}\n"
   }
  ]
 }
