diff --git a/saas/supabase/functions/overlay/index.ts b/saas/supabase/functions/overlay/index.ts
new file mode 100644
index 0000000..707b172
--- /dev/null
+++ b/saas/supabase/functions/overlay/index.ts
@@ -0,0 +1,34 @@
+// O projeto publicado de uma personalização do Site Editor, para o wc-runtime.js dos sites dos clientes.
+// GET /overlay?key=<chave pública>  ->  { project, updatedAt }
+// Público de propósito (os sites dos clientes não têm login): só devolve o que foi publicado, achado pela chave, e
+// nunca lista nada. CORS aberto, porque o script roda em qualquer domínio. A tabela continua fechada pelo RLS: a
+// leitura aqui usa a chave secreta.
+import { adminClient } from '../_shared/env.ts';
+
+const KEY = /^[A-Za-z0-9_-]{20,64}$/;
+
+function reply(body: unknown, status: number, maxAge = 0): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: {
+      'content-type': 'application/json; charset=utf-8',
+      'access-control-allow-origin': '*',
+      'access-control-allow-methods': 'GET, OPTIONS',
+      'access-control-allow-headers': 'accept, content-type',
+      'cache-control': maxAge > 0 ? `public, max-age=${maxAge}, stale-while-revalidate=300` : 'no-store',
+    },
+  });
+}
+
+export default {
+  fetch: async (req: Request): Promise<Response> => {
+    if (req.method === 'OPTIONS') return reply({}, 204);
+    if (req.method !== 'GET') return reply({ error: 'method_not_allowed' }, 405);
+    const key = new URL(req.url).searchParams.get('key') ?? '';
+    if (!KEY.test(key)) return reply({ error: 'invalid_key' }, 400);
+    const { data, error } = await adminClient().from('site_overlays').select('spec, updated_at').eq('public_key', key).eq('published', true).maybeSingle();
+    if (error) return reply({ error: 'unavailable' }, 503);
+    if (!data) return reply({ error: 'not_found' }, 404);
+    return reply({ project: data.spec, updatedAt: data.updated_at }, 200, 60);
+  },
+};
diff --git a/saas/supabase/migrations/20261021000200_site_overlays.sql b/saas/supabase/migrations/20261021000200_site_overlays.sql
new file mode 100644
index 0000000..bcca49e
--- /dev/null
+++ b/saas/supabase/migrations/20261021000200_site_overlays.sql
@@ -0,0 +1,55 @@
+-- Personalizações do Site Editor (a extensão que edita qualquer site): um projeto por linha, guardado inteiro em spec
+-- (o mesmo JSON da extensão, site-editor/src/shared/model.ts). Membros leem; editores criam e alteram; admins excluem.
+-- Publicar dá uma chave pública: o wc-runtime.js dos sites busca o projeto por ela na função "overlay", que lê com a
+-- chave secreta. A tabela em si nunca fica aberta a quem não está logado.
+
+create table public.site_overlays (
+  id           uuid primary key default gen_random_uuid(),
+  workspace_id uuid not null references public.workspaces(id) on delete cascade,
+  -- o projeto do editor a que esta personalização pertence (opcional)
+  project_id   uuid references public.projects(id) on delete set null,
+  -- o id do projeto dentro da extensão: a sincronização acha a linha por ele
+  local_id     text not null check (char_length(local_id) between 1 and 80),
+  name         text not null check (char_length(name) between 1 and 120),
+  matches      text[] not null default '{}',
+  spec         jsonb not null,
+  published    boolean not null default false,
+  public_key   text unique check (public_key is null or public_key ~ '^[A-Za-z0-9_-]{20,64}$'),
+  updated_by   uuid references auth.users(id) default auth.uid(),
+  created_at   timestamptz not null default now(),
+  updated_at   timestamptz not null default now(),
+  unique (workspace_id, local_id),
+  -- 5 MB por projeto: imagens enviadas viram data URL dentro do projeto
+  constraint site_overlays_spec_size check (pg_column_size(spec) <= 5 * 1024 * 1024)
+);
+create index site_overlays_workspace_id_idx on public.site_overlays (workspace_id);
+create index site_overlays_project_id_idx on public.site_overlays (project_id);
+
+alter table public.site_overlays enable row level security;
+
+create policy "so: members read" on public.site_overlays for select to authenticated
+  using (workspace_id in (select private.my_workspace_ids()));
+create policy "so: editors insert" on public.site_overlays for insert to authenticated
+  with check (private.has_role(workspace_id, array['owner', 'admin', 'editor']::public.workspace_role[]));
+create policy "so: editors update" on public.site_overlays for update to authenticated
+  using (private.has_role(workspace_id, array['owner', 'admin', 'editor']::public.workspace_role[]))
+  with check (private.has_role(workspace_id, array['owner', 'admin', 'editor']::public.workspace_role[]));
+create policy "so: admins delete" on public.site_overlays for delete to authenticated
+  using (private.has_role(workspace_id, array['owner', 'admin']::public.workspace_role[]));
+
+create trigger site_overlays_touch before update on public.site_overlays
+  for each row execute function private.touch_updated_at();
+
+-- o projeto ligado precisa ser do mesmo workspace
+create or replace function private.check_overlay_project() returns trigger
+language plpgsql security definer set search_path = '' as $$
+begin
+  if new.project_id is not null and not exists (
+    select 1 from public.projects p where p.id = new.project_id and p.workspace_id = new.workspace_id
+  ) then
+    raise exception 'overlay_project_other_workspace';
+  end if;
+  return new;
+end $$;
+create trigger site_overlays_project_check before insert or update on public.site_overlays
+  for each row execute function private.check_overlay_project();
