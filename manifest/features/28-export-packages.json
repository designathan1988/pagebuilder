{
  "group": "export-packages",
  "titleKey": "featureGroup.exportPackages",
  "features": [
    {
      "id": "export-packages",
      "titleKey": "feature.exportPackages",
      "commands": [
        "project.export"
      ],
      "dependsOn": [
        "export-zip"
      ],
      "intent": {
        "title": "The site exported as an installable web app, an Android and iOS project or a desktop project",
        "steps": [
          "File › Export as installable app (PWA): the site with a web app manifest, icons and a service worker.",
          "File › Export for Android and iPhone: a Capacitor project whose www/ is the site.",
          "File › Export for Windows, Mac and Linux: an Electron Forge project whose app/ is the site."
        ],
        "expected": [
          "Every page links the manifest and registers the service worker; the manifest names a 192px and a 512px icon, a start_url and a display.",
          "Each project holds a README in the site's language (README.md, or LEIA-ME.md for a Portuguese site) with the commands that build it."
        ]
      },
      "scenarios": [
        {
          "id": "the-site-exports-as-pwa",
          "setup": {
            "fixture": "aurora",
            "selection": [],
            "context": "global",
            "breakpoint": "desktop",
            "state": "base",
            "locale": "en",
            "viewport": "desktop-1440",
            "zoom": 100
          },
          "steps": [
            {
              "door": "project.export#menu-file-pwa",
              "args": {
                "format": "pwa"
              },
              "target": null,
              "drop": null,
              "action": true,
              "hold": false,
              "type": null
            }
          ],
          "doors": [
            "project.export#menu-file-pwa"
          ],
          "expect": {
            "document": [],
            "selection": [],
            "history": {
              "undoSteps": 0,
              "undoRestores": true,
              "redoRestores": true
            },
            "render": {
              "computed": [],
              "geometry": [],
              "feedback": [
                {
                  "key": "status.export.done",
                  "params": {
                    "file": "site-pwa.zip"
                  }
                }
              ]
            },
            "editor": null,
            "persistence": null,
            "export": {
              "files": [
                {
                  "path": "manifest.webmanifest",
                  "present": [
                    "\"display\": \"standalone\"",
                    "\"start_url\": \"./index.html\"",
                    "\"src\": \"icons/icon-512.png\""
                  ],
                  "absent": []
                },
                {
                  "path": "index.html",
                  "present": [
                    "<link rel=\"manifest\" href=\"manifest.webmanifest\">",
                    "navigator.serviceWorker.register('sw.js')"
                  ],
                  "absent": []
                },
                {
                  "path": "sw.js",
                  "present": [
                    "self.addEventListener('install'",
                    "\"./index.html\"",
                    "\"./css/styles.css\""
                  ],
                  "absent": []
                }
              ]
            }
          },
          "refusals": []
        },
        {
          "id": "the-site-exports-as-android",
          "setup": {
            "fixture": "aurora",
            "selection": [],
            "context": "global",
